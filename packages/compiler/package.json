{
  "name": "@jotastic/compiler",
  "version": "0.0.0",
  "description": "Compilador do Jotastic: transforma TSX em signals e bindings por nó.",
  "keywords": [
    "jotastic",
    "tsx",
    "signals",
    "compiler",
    "reactive"
  ],
  "homepage": "https://github.com/JonathanSantos/jotastic-js#readme",
  "bugs": "https://github.com/JonathanSantos/jotastic-js/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JonathanSantos/jotastic-js.git",
    "directory": "packages/compiler"
  },
  "author": "Jonathan Reis dos Santos",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@babel/core": "^7.25.0",
    "@babel/generator": "^7.25.0",
    "@babel/parser": "^7.25.0",
    "@babel/plugin-transform-typescript": "^7.29.9",
    "@babel/traverse": "^7.25.0",
    "@babel/types": "^7.25.0",
    "@jotastic/analyzer": "0.0.0"
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.0",
    "@types/babel__generator": "^7.6.0",
    "@types/babel__traverse": "^7.20.0",
    "jotastic": "0.0.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc -p ."
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
