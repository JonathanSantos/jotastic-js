{
  "name": "jotastic",
  "version": "0.0.0",
  "description": "Runtime do Jotastic: TSX puro, sem hooks, sem VDOM. Signals e bindings por nó gerados pelo compilador.",
  "keywords": [
    "jotastic",
    "tsx",
    "signals",
    "compiler",
    "reactive"
  ],
  "homepage": "https://github.com/JonathanSantos/jotastic-js#readme",
  "bugs": "https://github.com/JonathanSantos/jotastic-js/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JonathanSantos/jotastic-js.git",
    "directory": "packages/jotastic"
  },
  "author": "Jonathan Reis dos Santos",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/prod/index.d.ts",
      "development": "./dist/dev/index.js",
      "default": "./dist/prod/index.js"
    },
    "./runtime": {
      "types": "./dist/prod/runtime.d.ts",
      "development": "./dist/dev/runtime.js",
      "default": "./dist/prod/runtime.js"
    },
    "./runtime/hmr": {
      "types": "./dist/prod/runtime/hmr.d.ts",
      "development": "./dist/dev/runtime/hmr.js",
      "default": "./dist/prod/runtime/hmr.js"
    },
    "./store": {
      "types": "./dist/prod/store.d.ts",
      "development": "./dist/dev/store.js",
      "default": "./dist/prod/store.js"
    },
    "./fetch": {
      "types": "./dist/prod/fetch.d.ts",
      "development": "./dist/dev/fetch.js",
      "default": "./dist/prod/fetch.js"
    },
    "./jsx-runtime": {
      "types": "./src/jsx-runtime.d.ts"
    }
  },
  "files": [
    "dist",
    "src/jsx-runtime.d.ts"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc -p .",
    "typecheck:examples": "tsc -p test/types"
  },
  "jsdelivr": "./dist/prod/index.js",
  "unpkg": "./dist/prod/index.js",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
