{
  "name": "@jotastic/eslint-plugin",
  "version": "0.0.0",
  "description": "Regras ESLint para componentes Jotastic.",
  "keywords": [
    "jotastic",
    "tsx",
    "signals",
    "compiler",
    "reactive"
  ],
  "homepage": "https://github.com/JonathanSantos/jotastic-js#readme",
  "bugs": "https://github.com/JonathanSantos/jotastic-js/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JonathanSantos/jotastic-js.git",
    "directory": "packages/eslint-plugin"
  },
  "author": "Jonathan Reis dos Santos",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@babel/parser": "^7.25.0",
    "@jotastic/analyzer": "0.0.0",
    "@typescript-eslint/parser": "^8.0.0"
  },
  "peerDependencies": {
    "eslint": ">=9"
  },
  "devDependencies": {
    "eslint": "^9.0.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc -p ."
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
