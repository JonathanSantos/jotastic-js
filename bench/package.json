{
  "name": "jotastic-bench",
  "private": true,
  "type": "module",
  "scripts": {
    "deps": "npm run build -w jotastic -w @jotastic/analyzer -w @jotastic/compiler -w @jotastic/vite",
    "build": "vite build -c vite.jotastic.config.ts && vite build -c vite.solid.config.ts",
    "prebench": "npm run deps && npm run build",
    "bench": "node run.mjs"
  },
  "dependencies": {
    "jotastic": "0.0.0"
  },
  "devDependencies": {
    "@jotastic/vite": "0.0.0",
    "playwright": "^1.48.0",
    "solid-js": "^1.9.0",
    "vite": "^5.4.0",
    "vite-plugin-solid": "^2.10.0"
  }
}
